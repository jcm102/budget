
{
  "entities": {
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a task in the TaskTrack Budget application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Task entity."
        },
        "description": {
          "type": "string",
          "description": "Description of the task."
        },
        "dueDate": {
          "type": "string",
          "description": "The due date for the task.",
          "format": "date-time"
        },
        "frequency": {
          "type": "string",
          "description": "Frequency of the task (daily, weekly, monthly).",
          "format": "string"
        },
        "completed": {
          "type": "boolean",
          "description": "Indicates whether the task is completed or not."
        }
      },
      "required": [
        "id",
        "description",
        "dueDate",
        "frequency",
        "completed"
      ]
    },
    "LinkGroup": {
      "title": "Link Group",
      "type": "object",
      "description": "A group of links that can be associated with a task.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the LinkGroup entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the link group."
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "A list of URLs in the group."
        }
      },
      "required": ["id", "name", "links"]
    },
    "SinkingFundTransaction": {
      "title": "Sinking Fund Transaction",
      "type": "object",
      "description": "Represents a transaction for a sinking fund.",
      "properties": {
        "id": { "type": "string" },
        "fundId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdraw"] },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["id", "fundId", "amount", "type", "date"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/tasks/{taskId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Task"
          },
          "description": "Stores tasks for the application."
        }
      },
      {
        "path": "/link-groups/{linkGroupId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/LinkGroup"
          },
          "description": "Stores link groups for the application."
        }
      },
       {
        "path": "/sinking-fund-transactions/{transactionId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/SinkingFundTransaction"
          },
          "description": "Stores sinking fund transactions."
        }
      }
    ]
  }
}
