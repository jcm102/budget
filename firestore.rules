/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access data
 * explicitly associated with their user ID. This ensures data privacy and prevents
 * unauthorized access.
 *
 * Data Structure:
 * All data is nested under /users/{userId}. Tasks are stored under /users/{userId}/tasks/{taskId},
 * and link groups are stored under /users/{userId}/link-groups/{linkGroupId}.
 *
 * Key Security Decisions:
 * - Users can only access their own tasks and link groups.
 * - Data schema validation is relaxed to allow for rapid prototyping. Only the `id`
 *   field is validated on creation to ensure path consistency.
 * - List operations are allowed for the owner of a user subcollection.
 *
 * Denormalization for Authorization:
 *  N/A - The current structure inherently supports straightforward ownership checks
 *  based on the `/users/{userId}` path.  No denormalization is needed at this time.
 *
 * Structural Segregation:
 *  N/A - Private user subcollections are being used.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     * @principle Verified Identity
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the user ID.
     * @param {string} userId - The user ID to check against.
     * @principle Ownership
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the owner of the user ID and that resource exists.
     * @param {string} userId - The user ID to check against.
     * @principle Ownership & Existence
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces document ownership for writes.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - User 'user_abc' creates a task with task.id == 'user_abc'.
     * @deny (create) - User 'user_xyz' attempts to create a task under /users/user_abc/.
     * @principle Enforces document ownership for writes
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == taskId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces document ownership for Link Groups.
     * @path /users/{userId}/link-groups/{linkGroupId}
     * @allow (create) - User 'user_abc' creates a link group with linkGroup.id == 'link_group_123'.
     * @deny (create) - User 'user_xyz' attempts to create a link group under /users/user_abc/.
     * @principle Enforces document ownership for writes
     */
    match /users/{userId}/link-groups/{linkGroupId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == linkGroupId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }
  }
}