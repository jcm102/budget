/**
 * @file Firestore Security Rules for TaskTrack Budget Application
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model. Each user has exclusive
 *   access to their profile, tasks, and sessions. All data is nested under the `/users/{userId}`
 *   path, ensuring clear ownership and simplifying security rules.
 *
 * @data_structure
 *   - `/users/{userId}`: Stores user profiles. Only the authenticated user with matching `userId`
 *     can read or write their profile.
 *   - `/users/{userId}/tasks/{taskId}`: Stores tasks for a specific user. Only the owning user
 *     can manage their tasks.
 *   - `/users/{userId}/sessions/{sessionId}`: Stores session data for each user.
 *     Only the owning user can manage their sessions.
 *
 * @key_security_decisions
 *   - User listing is disallowed. This prevents potential information leakage.
 *   - Data validation is relaxed in this prototyping phase to allow for rapid iteration. Only
 *     authorization-critical fields (e.g., `userId` on `create`) are validated.
 *   - The rules explicitly deny any unauthorized access, ensuring a secure-by-default posture.
 *
 * @denormalization_for_authorization
 *   - The Task and Session documents have a `userId` field, which is redundant with the path
 *     `/users/{userId}/...` but dramatically simplifies the security rules and avoids the need
 *     for complex `get()` operations.
 *
 * @structural_segregation
 *   - All private user data is stored under the `/users/{userId}` path, isolating it from other
 *     users and simplifying access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profiles.
     * @path /users/{userId}
     * @allow (create) User with matching ID can create their profile.
     * @allow (get, update, delete) Authenticated user with matching ID can access and modify their profile.
     * @deny (create) User cannot create a profile with an ID that doesn't match their auth UID.
     * @deny (get, update, delete) Unauthorized user cannot access or modify another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Allow the user to create their own profile, but only if the userId matches their auth.uid.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // Allow read access if the user is signed in and the requested userId matches their auth.uid.
      allow get: if isSignedIn() && isOwner(userId);

      // Allow update if the user is signed in, the requested userId matches their auth.uid,
      // and the userId field in the data matches the userId in the path to prevent changing ownership.
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;

      // Allow delete if the user is signed in and the requested userId matches their auth.uid.
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.id == userId;

      // Prevent listing of all users.
      allow list: if false;
    }

    /**
     * @description Allows users to manage their own tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) Authenticated user with matching userId can create tasks.
     * @allow (get, list, update, delete) Authenticated user with matching userId can access and modify their tasks.
     * @deny (create) User cannot create a task with a userId that doesn't match their auth UID.
     * @deny (get, list, update, delete) Unauthorized user cannot access or modify another user's tasks.
     * @principle Enforces document ownership for all operations within the user's task collection.
     */
    match /users/{userId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Allow creating a task if the user is signed in and the userId matches their auth.uid.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;

      // Allow read access if the user is signed in and the userId matches their auth.uid.
      allow get: if isSignedIn() && isOwner(userId);

      // Allow listing tasks if the user is signed in and the userId matches their auth.uid.
      allow list: if isSignedIn() && isOwner(userId);

      // Allow updating a task if the user is signed in, the userId matches their auth.uid,
      // and the userId field in the data matches the userId in the path to prevent changing ownership.
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;

      // Allow deleting a task if the user is signed in and the userId matches their auth.uid.
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Allows users to manage their own sessions.
     * @path /users/{userId}/sessions/{sessionId}
     * @allow (create) Authenticated user with matching userId can create sessions.
     * @allow (get, list, update, delete) Authenticated user with matching userId can access and modify their sessions.
     * @deny (create) User cannot create a session with a userId that doesn't match their auth UID.
     * @deny (get, list, update, delete) Unauthorized user cannot access or modify another user's sessions.
     * @principle Enforces document ownership for all operations within the user's session collection.
     */
    match /users/{userId}/sessions/{sessionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Allow creating a session if the user is signed in and the userId matches their auth.uid.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;

      // Allow read access if the user is signed in and the userId matches their auth.uid.
      allow get: if isSignedIn() && isOwner(userId);

      // Allow listing sessions if the user is signed in and the userId matches their auth.uid.
      allow list: if isSignedIn() && isOwner(userId);

      // Allow updating a session if the user is signed in, the userId matches their auth.uid,
      // and the userId field in the data matches the userId in the path to prevent changing ownership.
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;

      // Allow deleting a session if the user is signed in and the userId matches their auth.uid.
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
    }
  }
}