/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for tasks. Each user can only
 * access the tasks associated with their own user ID. This ensures data privacy and
 * prevents unauthorized access to other users' tasks.
 *
 * Data Structure:
 * All tasks are nested under the `/users/{userId}/tasks/{taskId}` path, ensuring
 * clear ownership and easy management of user-specific data.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete tasks associated with their own ID.
 * - List operations are restricted to the owner of the tasks.
 * - Data validation is minimized to allow for flexible prototyping, but key ownership
 *   relationships are strictly enforced to prevent data leakage.
 *
 * Denormalization for Authorization:
 * The task's data is stored under a user-specific path `/users/{userId}/tasks/{taskId}`.
 * The authorization decision is then based on checking if the `request.auth.uid`
 * matches the `userId` path parameter. This avoids costly `get()` calls.
 *
 * Structural Segregation:
 * By storing tasks under a user-specific path, we avoid the need for complex queries
 * and ensure that each user's tasks are isolated from other users.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to task documents for individual users.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - A user can create a task under their own user ID.
     *   Example: request.auth.uid = "user123", path = "/users/user123/tasks/task456"
     * @allow (get, list, update, delete) - A user can access and modify tasks associated with their user ID.
     *   Example: request.auth.uid = "user123", path = "/users/user123/tasks/task456"
     * @deny (create) - A user cannot create a task under another user's ID.
     *   Example: request.auth.uid = "user456", path = "/users/user123/tasks/task456"
     * @deny (get, list, update, delete) - A user cannot access or modify tasks associated with another user's ID.
     *   Example: request.auth.uid = "user456", path = "/users/user123/tasks/task456"
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      // Helper function to check if the request is made by the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the request is made by an existing owner of the document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow anyone to get a task if they are authenticated
      allow get: if isSignedIn() && isOwner(userId);

      // Allow the user to list their own tasks.
      allow list: if isSignedIn() && isOwner(userId);

      // Allow the user to create a task if the userId matches the authenticated user's ID.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == taskId;

      // Allow the user to update a task if they are the owner of the task and the document exists.
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.id == request.resource.data.id;

      // Allow the user to delete a task if they are the owner of the task and the document exists.
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }

  // Helper function to check if a user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}