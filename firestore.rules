/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for managing tasks in the TaskTrack Budget application.
 *
 * Data Structure:
 * All tasks are nested under /users/{userId}/tasks/{taskId}, ensuring that each user's tasks are isolated and accessible only to them.
 *
 * Key Security Decisions:
 * - Users can only access their own tasks.
 * - Listing other user's tasks is explicitly denied.
 * - Schema validation is relaxed in favor of rapid prototyping. Only relational integrity is enforced.
 * - Read-only collections are not used in this data model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages tasks associated with a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - A user with UID 'user123' can create a task with `id: 'user123'` under /users/user123/tasks/task456 if authenticated.
     * @allow (update) - A user with UID 'user123' can update a task with `id: 'user123'` under /users/user123/tasks/task456 if authenticated.
     * @allow (delete) - A user with UID 'user123' can delete a task under /users/user123/tasks/task456 if authenticated.
     * @allow (get) - A user with UID 'user123' can get a task under /users/user123/tasks/task456 if authenticated.
     * @allow (list) - A user with UID 'user123' can list tasks under /users/user123/tasks.
     * @deny (create) - A user with UID 'user456' cannot create a task under /users/user123/tasks/task456.
     * @deny (update) - A user with UID 'user456' cannot update a task under /users/user123/tasks/task456.
     * @deny (delete) - A user with UID 'user456' cannot delete a task under /users/user123/tasks/task456.
     * @deny (get) - A user with UID 'user456' cannot get a task under /users/user123/tasks/task456.
     * @deny (list) - A user with UID 'user456' cannot list tasks under /users/user123/tasks.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/tasks/{taskId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the resource
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Helper function to check if the user is the owner of the existing resource
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Read rules
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      // Write rules
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }
  }
}