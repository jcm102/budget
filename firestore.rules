/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for all data. Users can only
 * access their own data, ensuring privacy and data isolation. This is achieved
 * primarily through path-based authorization. No listing of all users is allowed.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/tasks/{taskId}: Stores tasks owned by a specific user.
 * - /users/{userId}/sessions/{sessionId}: Stores session information for each user.
 *
 * Key Security Decisions:
 * - Strict User Ownership: Only the authenticated user can read or write their own data.
 * - No Public Listing: Listing of all users is explicitly denied.
 *
 * Denormalization for Authorization:
 *  - Not used, all authorization is based on path.
 * Structural Segregation:
 *  - User data is segregated into subcollections under the /users/{userId} path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own user document.
     * @allow (get, update, delete) - Authenticated user can access their own user document.
     * @deny (list) - Listing all users is prohibited.
     * @deny (create, update, delete) - Non-authenticated users cannot create or modify user documents.
     * @principle Enforces document ownership and prevents unauthorized data access.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to the /users/{userId}/tasks/{taskId} collection.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - Authenticated user can create tasks under their own user document.
     * @allow (get, list, update, delete) - Authenticated user can access their own tasks.
     * @deny (create, update, delete) - Non-authenticated users cannot create or modify tasks.
     * @principle Enforces document ownership for tasks and prevents unauthorized modifications.
     */
    match /users/{userId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to the /users/{userId}/sessions/{sessionId} collection.
     * @path /users/{userId}/sessions/{sessionId}
     * @allow (create) - Authenticated user can create sessions under their own user document.
     * @allow (get, list, update, delete) - Authenticated user can access their own sessions.
     * @deny (create, update, delete) - Non-authenticated users cannot create or modify sessions.
     * @principle Enforces document ownership for sessions and prevents unauthorized modifications.
     */
    match /users/{userId}/sessions/{sessionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
     /**
      * @description  Denies access to the `link-groups` collection.
      * @path /link-groups
      * @allow None
      * @deny Any request.
      * @principle Access to this collection is completely restricted.
      */
     match /link-groups/{document} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
     }

  }
}