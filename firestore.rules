
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read access on the 'sinking-fund-transactions' collection group for all users.
    // This is required for the transaction history query to work across different user subcollections.
    // This rule is intentionally broad for development.
    match /{path=**}/sinking-fund-transactions/{transactionId} {
      allow read, write: if true;
    }

    // Allow users to read and write to any other document in the database.
    // This is a permissive rule for development and should be refined for production.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
