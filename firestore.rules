/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model where each user can only
 * access data associated with their own user ID.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, segregating data per user.
 * Tasks are stored in /users/{userId}/tasks/{taskId}, and link groups are stored
 * in /users/{userId}/link-groups/{linkGroupId}.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own tasks and link groups.
 * - Listing of all users is disallowed.
 *
 * Denormalization for Authorization:
 * The rules leverage the path to enforce ownership, avoiding the need to
 * duplicate user IDs within the document data itself.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) User 'user123' can create a task under their user ID.
     * @allow (get) User 'user123' can get a task under their user ID.
     * @allow (update) User 'user123' can update a task under their user ID.
     * @allow (delete) User 'user123' can delete a task under their user ID.
     * @deny (create) User 'user456' cannot create a task under user 'user123'.
     * @deny (get) User 'user456' cannot get a task under user 'user123'.
     * @deny (update) User 'user456' cannot update a task under user 'user123'.
     * @deny (delete) User 'user456' cannot delete a task under user 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == taskId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages access to user link groups.
     * @path /users/{userId}/link-groups/{linkGroupId}
     * @allow (create) User 'user123' can create a link group under their user ID.
     * @allow (get) User 'user123' can get a link group under their user ID.
     * @allow (update) User 'user123' can update a link group under their user ID.
     * @allow (delete) User 'user123' can delete a link group under their user ID.
     * @deny (create) User 'user456' cannot create a link group under user 'user123'.
     * @deny (get) User 'user456' cannot get a link group under user 'user123'.
     * @deny (update) User 'user456' cannot update a link group under user 'user123'.
     * @deny (delete) User 'user456' cannot delete a link group under user 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/link-groups/{linkGroupId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == linkGroupId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    //--------------------------------------------------------------------------------
    // Helper functions
    //--------------------------------------------------------------------------------

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's ID.
     * @param {string} userId The user ID to check.
     * @return {bool} True if the user ID matches the authenticated user's ID, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Combines ownership check with document existence check.
     * @param {string} userId The user ID to check.
     * @return {bool} True if the user ID matches the authenticated user's ID and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}