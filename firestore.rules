rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can read and write to their own documents.
    match /users/{userId} {
      // User can manage their own user document
      allow read, write: if request.auth.uid == userId;

      // User can manage their own tasks
      match /tasks/{taskId} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User can manage their own link groups
      match /link-groups/{linkGroupId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
  }
}