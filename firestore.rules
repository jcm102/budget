/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own tasks and link groups.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, with subcollections for tasks and link groups.
 *  - `/users/{userId}/tasks/{taskId}`: Stores individual task documents.
 *  - `/users/{userId}/link-groups/{linkGroupId}`: Stores link group documents.
 *
 * Key Security Decisions:
 *  - Users can only access data under their own user ID.
 *  - No user listing is allowed.
 *
 * Denormalization for Authorization:
 *  - The `userId` is encoded in the document path (`/users/{userId}/...`), which is used for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure the /users/{userId} collection. Allows a user to create their own document.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own user document.
     *   Example: A user with UID "user123" creates a document at /users/user123.
     * @deny (get, list, update, delete) - Any other operation on a user document is denied.
     *   Example: A user attempts to read another user's document.
     * @principle Enforces user-ownership.
     */
    match /users/{userId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Secure the /users/{userId}/tasks/{taskId} collection. Allows a user to manage their own tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - Authenticated user creates a task under their user ID.
     *   Example: A user with UID "user123" creates a task at /users/user123/tasks/task456.
     * @allow (get, list, update, delete) - Authenticated user reads, updates, or deletes a task under their user ID.
     *   Example: A user with UID "user123" updates a task at /users/user123/tasks/task456.
     * @deny (create, get, list, update, delete) - Any operation on a task that doesn't belong to the authenticated user is denied.
     *   Example: A user attempts to read another user's task.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == taskId;
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Secure the /users/{userId}/link-groups/{linkGroupId} collection. Allows a user to manage their own link groups.
     * @path /users/{userId}/link-groups/{linkGroupId}
     * @allow (create) - Authenticated user creates a link-group under their user ID.
     *   Example: A user with UID "user123" creates a link-group at /users/user123/link-groups/group789.
     * @allow (get, list, update, delete) - Authenticated user reads, updates, or deletes a link-group under their user ID.
     *   Example: A user with UID "user123" updates a link-group at /users/user123/link-groups/group789.
     * @deny (create, get, list, update, delete) - Any operation on a link-group that doesn't belong to the authenticated user is denied.
     *   Example: A user attempts to read another user's link-group.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/link-groups/{linkGroupId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == linkGroupId;
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}