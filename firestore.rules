/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for tasks. Each user can only
 * access the tasks that belong to them.
 *
 * Data Structure:
 * All task data is nested under `/users/{userId}/tasks/{taskId}`. This hierarchical
 * structure simplifies authorization based on the user ID in the path.
 *
 * Key Security Decisions:
 * - Users can only list tasks under their own user ID.
 * - Users cannot create tasks directly at the root level.
 * - Data validation is relaxed to allow rapid prototyping and iteration.
 *
 * Denormalization for Authorization:
 * The chosen data structure denormalizes user ownership directly into the path. This allows
 * rules to avoid `get()` calls and other complex queries, improving performance and security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines the global function `isSignedIn()` to check if a user is authenticated.
     * @returns {boolean} True if the user is signed in, false otherwise.
     * @example
     * allow read: if isSignedIn();
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Defines the global function `isOwner(userId)` to check if the request is made by the owner of the document.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @returns {boolean} True if the request is made by the owner, false otherwise.
     * @example
     * allow read: if isOwner(userId);
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Defines the global function `isExistingOwner(userId)` to check if the request is made by an owner of an existing document.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @returns {boolean} True if the request is made by the owner of an existing document, false otherwise.
     * @example
     * allow update, delete: if isExistingOwner(userId);
     */
    function isExistingOwner(userId) {
      return request.auth.uid == userId && existsAfter(/databases/$(database)/documents/users/$(userId)/tasks/$(taskId));
    }


    /**
     * @description Enforces ownership-based access control for tasks.  Users can only
     *              read, create, update, and delete tasks associated with their own user ID.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - User KTxToiUNJYRdeESKnMhxKovxpB53 can create a task under /users/KTxToiUNJYRdeESKnMhxKovxpB53/tasks/{taskId} if request.auth.uid == userId.
     * @allow (get, list) - User KTxToiUNJYRdeESKnMhxKovxpB53 can read and list tasks under /users/KTxToiUNJYRdeESKnMhxKovxpB53/tasks if request.auth.uid == userId.
     * @allow (update, delete) - User KTxToiUNJYRdeESKnMhxKovxpB53 can update and delete a task under /users/KTxToiUNJYRdeESKnMhxKovxpB53/tasks/{taskId} if request.auth.uid == userId and the document exists.
     * @deny (create) - User ABC cannot create a task under /users/KTxToiUNJYRdeESKnMhxKovxpB53/tasks/{taskId}.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      // Read rules
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      // Write rules
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

     match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}