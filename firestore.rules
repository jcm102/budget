/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for tasks. Each user can only
 * access the tasks that belong to them.
 *
 * Data Structure:
 * All task data is nested under `/users/{userId}/tasks/{taskId}`. This hierarchical
 * structure simplifies authorization based on the user ID in the path.
 *
 * Key Security Decisions:
 * - Users can only list tasks that belong to them. Public listing of tasks is disallowed.
 * - Ambiguous or missing authorization information defaults to a deny.
 *
 * Denormalization for Authorization:
 * The task data model requires each task to be stored under the user's ID path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures access to user-specific task documents.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - Authenticated user 'KTxToiUNJYRdeESKnMhxKovxpB53' can create a task under their own user ID.
     * @allow (get) - Authenticated user 'KTxToiUNJYRdeESKnMhxKovxpB53' can retrieve a task under their own user ID.
     * @allow (list) - Authenticated user 'KTxToiUNJYRdeESKnMhxKovxpB53' can list tasks under their own user ID.
     * @allow (update) - Authenticated user 'KTxToiUNJYRdeESKnMhxKovxpB53' can update a task under their own user ID.
     * @allow (delete) - Authenticated user 'KTxToiUNJYRdeESKnMhxKovxpB53' can delete a task under their own user ID.
     * @deny (create) - Authenticated user 'someOtherUserId' cannot create a task under user ID 'KTxToiUNJYRdeESKnMhxKovxpB53'.
     * @principle Enforces document ownership for all operations on tasks.
     */
    match /users/{userId}/tasks/{taskId} {
      // Read Permissions
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      // Write Permissions
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == taskId;
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}