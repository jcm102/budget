
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access, but only allow writes for authenticated users.
    // This is a temporary measure to fix server-side rendering issues.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read and write files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
