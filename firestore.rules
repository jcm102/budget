/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for managing tasks in the TaskTrack Budget application.
 *
 * Data Structure:
 * - All tasks are nested under /users/{userId}/tasks/{taskId}, ensuring that each user's tasks are isolated.
 *
 * Key Security Decisions:
 * - Users can only access their own tasks.
 * - Listing tasks is restricted to the owner.
 * - Data validation is minimal in this prototyping phase, focusing on ownership and relational integrity.
 *
 * Denormalization for Authorization:
 * - The task ID is duplicated within the task document to prevent unauthorized creation or modification of tasks in other users' paths.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces ownership for tasks stored under a user-specific path.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - User 'user_abc' creates a new task with task.id == 'user_abc'.
     * @allow (get, list, update, delete) - User 'user_abc' reads/modifies task 'task_123' under /users/user_abc/tasks/task_123.
     * @deny (create) - User 'user_abc' attempts to create a task under /users/user_xyz/tasks.
     * @deny (get, list, update, delete) - User 'user_xyz' attempts to read/modify task 'task_123' under /users/user_abc/tasks/task_123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allows creating a task if the user is signed in and the userId matches the authenticated user's ID
      allow create: if isSignedIn()
                   && isOwner(userId)
                   && request.resource.data.id == taskId;

      // Allows reading a task if the user is the owner
      allow get: if isOwner(userId);

      // Allows listing tasks if the user is the owner
      allow list: if isOwner(userId);

      // Allows updating a task if the user is the owner and the document exists, also prevents modification of ownership
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Allows deleting a task if the user is the owner and the document exists
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Restricts listing link-groups to authenticated users.
     * @path /link-groups
     * @allow (list) - Any authenticated user can list link-groups.
     * @deny (list) - Unauthenticated users cannot list link-groups.
     * @principle Public read with authenticated access.
     */
    match /link-groups {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}