/**
 * @description This ruleset enforces a strict user-ownership model for tasks,
 *              allowing users to manage their own tasks under their respective user IDs.
 *              It also allows public read access to the link-groups collection.
 * @dataStructure All tasks are nested under /users/{userId}/tasks/{taskId},
 *                ensuring that tasks are isolated to their owners.
 * @keySecurityDecisions Listing link-groups are allowed for all users, but all user tasks are private to the user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows the owner of the account to do anything they want.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - Allow creation if request.auth.uid matches userId and task ids match.
     * @allow (update) - Allow update if request.auth.uid matches userId and task ids match.
     * @allow (delete) - Allow delete if request.auth.uid matches userId.
     * @allow (get) - Allow get if request.auth.uid matches userId.
     * @allow (list) - Allow list if request.auth.uid matches userId.
     * @deny (create) - Deny creation if request.auth.uid does not match userId.
     * @deny (update) - Deny update if request.auth.uid does not match userId.
     * @deny (delete) - Deny delete if request.auth.uid does not match userId.
     * @deny (get) - Deny get if request.auth.uid does not match userId.
     * @deny (list) - Deny list if request.auth.uid does not match userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == taskId;
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == request.resource.data.id && resource != null;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows any user to list the link groups
     * @path /link-groups
     * @allow (list) Any user can list link groups.
     * @principle Public listing is allowed
     */
    match /link-groups {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }

  // Helper function to determine if the user is signed in
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    // Helper function to determine if the user is the owner and the resource exists
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}