/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the TaskTrack Budget application.
 *
 * Core Philosophy:
 *  - Public Read, Owner-Only Write. This ruleset allows all users to read tasks,
 *    but restricts creation, modification, and deletion of tasks to the owner.
 *
 * Data Structure:
 *  - Tasks are stored in the top-level `/tasks/{taskId}` collection.
 *
 * Key Security Decisions:
 *  - Tasks are publicly readable.
 *  - Only the task creator can modify or delete a task.
 *  - The rules enforce the existence of an `ownerId` on each task, and ensures
 *    that this field matches the authenticated user's UID upon creation.
 *  - Listing all tasks is allowed for any user.
 *
 * Denormalization for Authorization:
 *  - The `Task` entity MUST include an `ownerId` field.
 *    This field is used to control write access, avoiding the need for complex
 *    `get()` calls to other collections. The `create` rule validates that
 *    `request.resource.data.ownerId == request.auth.uid`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure the `/tasks/{taskId}` collection. All users can read tasks,
     *   but only the task owner can create, update, or delete.
     * @path /tasks/{taskId}
     * @allow (get, list): Any user can read or list all tasks.
     * @allow (create): Only the authenticated user can create a task,
     *   and the `ownerId` field must match the user's UID.
     *   Example:
     *   - Request: `create /tasks/task1 { ownerId: 'user123', description: 'Buy milk' }`
     *   - Auth: `auth.uid == 'user123'`
     * @allow (update, delete): Only the owner of the task can modify or delete it.
     *   Example:
     *   - Request: `update /tasks/task1 { description: 'Buy organic milk' }`
     *   - Auth: `auth.uid == 'user123'`, and the existing document has `ownerId: 'user123'`
     * @deny (create): Creation is denied if the `ownerId` field does not match the
     *   authenticated user's UID.
     *   Example:
     *   - Request: `create /tasks/task1 { ownerId: 'user456', description: 'Buy milk' }`
     *   - Auth: `auth.uid == 'user123'`
     * @deny (update, delete): Modification or deletion is denied if the authenticated user
     *   is not the owner of the task.
     *   Example:
     *   - Request: `update /tasks/task1 { description: 'Buy organic milk' }`
     *   - Auth: `auth.uid == 'user456'`, but the existing document has `ownerId: 'user123'`
     * @principle Enforces public read access with owner-only writes.  Validates
     *   the `ownerId` field on creation and verifies ownership for updates and deletes.
     */
    match /tasks/{taskId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.ownerId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.ownerId);
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is authenticated; false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return True if the user is the owner; false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return True if the user is the owner and the resource exists; false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}