/**
 * @fileoverview Firestore Security Rules for TaskTrack Budget application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for tasks. Each user can only
 * access the tasks that belong to them.
 *
 * Data Structure:
 * All task data is nested under `/users/{userId}/tasks/{taskId}`. This path-based
 * ownership makes security rules simple and efficient.
 *
 * Key Security Decisions:
 * - Users can only list tasks that belong to them.
 * - Data validation is minimal to allow for rapid prototyping. Only authorization-critical
 *   fields are validated.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the task collection for a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - A user can create a task under their own user ID.
     * @allow (update) - A user can update a task under their own user ID if the task exists.
     * @allow (delete) - A user can delete a task under their own user ID if the task exists.
     * @allow (get) - A user can get a task under their own user ID.
     * @allow (list) - A user can list tasks under their own user ID.
     * @deny (create) - A user cannot create a task under another user's ID.
     * @deny (update) - A user cannot update a task under another user's ID.
     * @deny (delete) - A user cannot delete a task under another user's ID.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/tasks/{taskId} {
      // Helpers
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Read Permissions
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      // Write Permissions
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == taskId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

      /**
       * @description Prevents unauthorized listing of link-groups
       * @path /link-groups
       * @allow None
       * @deny All list requests
       * @principle Explicitly deny listing on link-groups
       */
    match /link-groups {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

  }
}